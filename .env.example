# Copy this file to .env and fill in your own keys.
# See README.md "Where to get each key" for how to obtain each of these.

# Gemini (AI commentary, second fallback) — aistudio.google.com
GEMINI_API_KEY=
# Optional — overrides the default model. Leave blank to use the built-in default.
# Default: gemini-2.5-flash
GEMINI_MODEL=

# Groq (AI commentary, primary) — console.groq.com
GROQ_API_KEY=
# Optional — overrides the default model. Leave blank to use the built-in default.
# Providers retire/rename models every few months; if Groq calls start
# returning 404, check console.groq.com/docs/models for the current name
# and set it here instead of editing code.
# Default: openai/gpt-oss-120b
GROQ_MODEL=

# Mistral (AI commentary, fallback) — console.mistral.ai
MISTRAL_API_KEY=
# Optional overrides — leave blank to use the built-in defaults.
# MISTRAL_MODEL is used for the heavier calls (portfolio insight, summary).
# MISTRAL_FAST_MODEL is used for lightweight calls (news sentiment, PE/price estimation).
# Defaults: mistral-small-latest / open-mistral-7b
MISTRAL_MODEL=
MISTRAL_FAST_MODEL=

# NewsAPI (news fetching) — newsapi.org
NEWS_API_KEY=

# Angel One SmartAPI (primary live price source) — smartapi.angelbroking.com
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=
